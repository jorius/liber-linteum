<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- WKWebView derives navigator.languages from the bundle's localizations (Q-I18N-1). -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>es</string>
  </array>
  <!-- M6: macOS asks the first time a clip is recorded; the microphone is
       open only while recording. Tauri merges this into the bundle. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Liber Linteum records audio clips into your notes only while you record one.</string>
</dict>
</plist>
