    "allow-entry-trash",
    "allow-settings-get",
    "allow-settings-set",
    "allow-vaults-recent",
    "allow-vaults-forget",
    "allow-vaults-reveal",
    "allow-page-read",
    "allow-page-write",
    "allow-page-create-conflict-copy",
    "allow-links-resolve",
    "allow-url-open",
    "allow-file-open-external",
    "allow-fonts-list",
