{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window. Only explicitly listed commands are callable; each milestone adds its own. The dialog plugin is limited to the folder picker (cover images are picked by a dialog Rust opens itself, M2c §8); the event plugin only to listen/unlisten (the UI subscribes to vault:* events); the window plugin only to destroy (the UI closes the window itself after saving unsaved pages).",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-vault-open",
    "allow-vault-create",
    "allow-vault-close",
    "allow-vault-tree",
    "allow-page-get",
    "allow-backlink-count",
    "allow-entry-create-page",
    "allow-entry-create-folder",
    "allow-entry-rename",
    "allow-entry-trash",
    "allow-settings-get",
    "allow-settings-set",
    "allow-vaults-recent",
    "allow-vaults-forget",
    "allow-page-read",
    "allow-page-write",
    "allow-page-create-conflict-copy",
    "allow-links-resolve",
    "allow-url-open",
    "allow-file-open-external",
    "allow-fonts-list",
    "allow-vault-settings-get",
    "allow-vault-settings-set",
    "allow-attachment-paste",
    "allow-attachment-import",
    "allow-cover-pick",
    "allow-link-suggest",
    "allow-gv-children",
    "allow-gv-edges",
    "allow-layout-get",
    "allow-layout-set",
    "allow-link-target",
    "allow-index-pick-set",
    "allow-page-width-set",
    "allow-text-read",
    "allow-text-write",
    "allow-entry-create-text",
    "allow-cover-height-set",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "dialog:allow-open"
  ]
}
