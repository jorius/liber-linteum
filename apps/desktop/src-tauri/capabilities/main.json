{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window. Only explicitly listed commands are callable; each milestone adds its own. The dialog plugin is limited to the folder picker (cover images are picked by a dialog Rust opens itself, M2c §8); the event plugin only to listen/unlisten (the UI subscribes to vault:* events); no window plugin: the UI closes its own window with window_close_self after saving unsaved pages (M4c review I2).",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-window-close-self",
    "allow-window-title-set",
    "allow-vault-open",
    "allow-vault-create",
    "allow-vault-close",
    "allow-vault-tree",
    "allow-page-get",
    "allow-backlink-count",
    "allow-entry-create-page",
    "allow-entry-create-folder",
    "allow-entry-rename",
    "allow-entry-trash",
    "allow-settings-get",
    "allow-settings-set",
    "allow-vaults-recent",
    "allow-vaults-forget",
    "allow-page-read",
    "allow-page-write",
    "allow-page-create-conflict-copy",
    "allow-links-resolve",
    "allow-url-open",
    "allow-file-open-external",
    "allow-fonts-list",
    "allow-vault-settings-get",
    "allow-vault-settings-set",
    "allow-attachment-paste",
    "allow-attachment-import",
    "allow-cover-pick",
    "allow-link-suggest",
    "allow-gv-children",
    "allow-gv-edges",
    "allow-layout-get",
    "allow-layout-set",
    "allow-link-target",
    "allow-index-pick-set",
    "allow-page-width-set",
    "allow-text-read",
    "allow-text-write",
    "allow-entry-create-text",
    "allow-cover-height-set",
    "allow-cover-side-set",
    "allow-cover-width-set",
    "allow-links-external",
    "allow-external-open",
    "allow-external-reveal",
    "allow-external-network-allow",
    "allow-file-pick",
    "allow-scratchpad-default",
    "allow-scratchpad-choose",
    "allow-scratchpad-set",
    "allow-scratchpad-open",
    "allow-quick-note-create",
    "allow-quick-note-autoname",
    "allow-quick-notes-state",
    "allow-scratch-folder-set",
    "allow-file-open-dialog",
    "allow-search",
    "allow-folder-icon-set",
    "allow-vault-icon-set",
    "allow-bin-list",
    "allow-trash-restore",
    "allow-trash-delete",
    "allow-trash-empty",
    "allow-entry-archive",
    "allow-archive-restore",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open"
  ]
}
