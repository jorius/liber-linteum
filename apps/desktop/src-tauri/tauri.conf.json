{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liber Linteum",
  "version": "0.1.2",
  "identifier": "app.liberlinteum.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Liber Linteum",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' liber-asset: http://liber-asset.localhost data: blob:",
        "media-src": "'self' liber-asset: http://liber-asset.localhost blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"],
    "category": "Productivity",
    "license": "GPL-3.0-or-later",
    "resources": {
      "../../../THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md",
      "../../../crates/liber-spell/dictionaries/en_US/LICENSE": "licenses/dictionary-en_US.txt",
      "../../../crates/liber-spell/dictionaries/es/LICENSE": "licenses/dictionary-es.txt",
      "../../../crates/liber-spell/dictionaries/es_CO/LICENSE": "licenses/dictionary-es_CO.txt"
    },
    "shortDescription": "Private, local-only notes with a visual Global View.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
